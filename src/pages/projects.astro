---
import Layout from '../layouts/Layout.astro';
import { site, projects } from '../config/site';
---

<Layout title="Projects" description={`Coding projects by ${site.name}`}>
  <section class="mb-8">
    <h1 class="text-[clamp(1.8rem,5vw,2.4rem)]">Projects</h1>
    <p class="mt-2 text-muted">Things I've built. Source and live links where available.</p>
  </section>

  <div class="grid gap-4 grid-cols-[repeat(auto-fit,minmax(17rem,1fr))]">
    {
      projects.map((project) => {
        const primary = project.url ?? project.repo;
        return (
          <article class="flex flex-col gap-[0.6rem] rounded-lg border border-border bg-surface p-5 shadow-soft">
            <h2 class="text-[1.15rem]">
              {primary ? (
                <a href={primary} target="_blank" rel="noopener noreferrer">
                  {project.name} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                project.name
              )}
            </h2>
            <p class="text-muted">{project.description}</p>
            {project.tags && (
              <ul class="flex flex-wrap gap-[0.4rem]">
                {project.tags.map((tag) => (
                  <li class="rounded-md border border-border px-[0.6rem] py-[0.1rem] text-[0.75rem] text-muted">{tag}</li>
                ))}
              </ul>
            )}
            <div class="mt-auto flex gap-4 text-[0.9rem]">
              {project.repo && (
                <a href={project.repo} target="_blank" rel="noopener noreferrer">
                  Code
                </a>
              )}
              {project.url && (
                <a href={project.url} target="_blank" rel="noopener noreferrer">
                  Live
                </a>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</Layout>
