---
import Layout from '../layouts/Layout.astro';
import { site, projects } from '../config/site';
---

<Layout title="Projects" description={`Coding projects by ${site.name}`}>
  <section class="page-head">
    <h1>Projects</h1>
    <p>Things I've built. Source and live links where available.</p>
  </section>

  <div class="cards">
    {
      projects.map((project) => {
        const primary = project.url ?? project.repo;
        return (
          <article class="card">
            <h2>
              {primary ? (
                <a href={primary} target="_blank" rel="noopener noreferrer">
                  {project.name} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                project.name
              )}
            </h2>
            <p>{project.description}</p>
            {project.tags && (
              <ul class="tags">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
            <div class="links">
              {project.repo && (
                <a href={project.repo} target="_blank" rel="noopener noreferrer">
                  Code
                </a>
              )}
              {project.url && (
                <a href={project.url} target="_blank" rel="noopener noreferrer">
                  Live
                </a>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</Layout>

<style>
  .page-head {
    margin-bottom: 2rem;
  }

  .page-head h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
  }

  .page-head p {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }

  .card {
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card h2 {
    font-size: 1.15rem;
  }

  .card p {
    color: var(--color-muted);
    margin: 0;
  }

  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li {
    font-size: 0.75rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    font-size: 0.9rem;
  }
</style>
