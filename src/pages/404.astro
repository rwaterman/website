---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404">
  <section class="notfound">
    <h1>404</h1>
    <p>This page could not be found.</p>
    <p><a class="button" href="/">Go home</a></p>
  </section>
</Layout>

<style>
  .notfound {
    text-align: center;
    padding: 4rem 1rem;
  }

  .notfound h1 {
    font-size: 3.5rem;
  }

  .notfound p {
    margin-top: 0.75rem;
    color: var(--color-muted);
  }

  .notfound .button {
    margin-top: 1.5rem;
    color: var(--color-accent-contrast);
  }
</style>
