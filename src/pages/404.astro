---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404">
  <section class="py-12">
    <p class="label">Error 404</p>
    <h1 class="mt-3 font-display text-[clamp(3rem,10vw,6rem)] font-bold uppercase leading-[0.95]">Not found</h1>
    <p class="mt-4 max-w-[36rem] text-muted">There's nothing at this address.</p>
    <p class="mt-8"><a class="button" href="/">Go home</a></p>
  </section>
</Layout>
