---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
---

<Layout background="waves" heading="Resume" description={`Resume — ${site.name}`}>
  <a slot="aside" class="button" href={site.links.resumePdf} target="_blank" rel="noopener noreferrer">
    Download PDF <span aria-hidden="true">↓</span>
  </a>

  <object
    class="mt-10 h-[min(80vh,1100px)] w-full bg-surface-2 shadow-[0_0_0_1px_var(--color-rule)]"
    data={site.links.resumePdf}
    type="application/pdf"
    aria-label={`${site.name} resume`}
  >
    <div class="flex h-full flex-col items-center justify-center gap-4 p-8 text-center text-muted">
      <p>This browser can't display the embedded PDF.</p>
      <a class="button" href={site.links.resumePdf} target="_blank" rel="noopener noreferrer">
        Open the PDF <span aria-hidden="true">↗</span>
      </a>
    </div>
  </object>
</Layout>
