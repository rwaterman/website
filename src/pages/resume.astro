---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
---

<Layout title="Resume" description={`Resume — ${site.name}`}>
  <section class="resume">
    <header class="resume__head">
      <h1>Resume</h1>
      <a class="button" href={site.links.resumePdf} target="_blank" rel="noopener noreferrer">
        Download PDF <span aria-hidden="true">↓</span>
      </a>
    </header>

    <object class="resume__viewer" data={site.links.resumePdf} type="application/pdf" aria-label={`${site.name} resume`}>
      <div class="resume__fallback">
        <p>This browser can't display the embedded PDF.</p>
        <a class="button" href={site.links.resumePdf} target="_blank" rel="noopener noreferrer">
          Open the PDF <span aria-hidden="true">↗</span>
        </a>
      </div>
    </object>
  </section>
</Layout>

<style>
  .resume__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .resume__head h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
  }

  .resume__viewer {
    width: 100%;
    height: min(80vh, 1100px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .resume__fallback {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    text-align: center;
    color: var(--color-muted);
  }
</style>
