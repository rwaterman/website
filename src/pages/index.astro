---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';

const focusAreas = [
  {
    title: 'Cloud architecture',
    blurb: 'AWS account strategy, delivery paths, and production systems shaped for long-term ownership.',
  },
  {
    title: 'Serverless platforms',
    blurb: 'Event-driven services, APIs, and deployment workflows that keep teams moving without excess machinery.',
  },
  {
    title: 'Data systems',
    blurb: 'Practical data pipelines, storage models, and observability patterns for systems people can operate.',
  },
];
---

<Layout>
  <section
    class="grid items-center gap-[clamp(1.25rem,4vw,3rem)] border-b border-border pt-2 pb-[3.25rem] grid-cols-[minmax(0,1fr)_minmax(17rem,22rem)] max-[1080px]:grid-cols-1 max-[1080px]:items-start"
  >
    <div>
      <p class="mb-[0.45rem] text-[0.82rem] font-bold uppercase tracking-[0.08em] text-accent">{site.role}</p>
      <h1 class="text-[clamp(2.6rem,7vw,4.8rem)] tracking-[-0.04em]">{site.name}</h1>
      <p class="mt-5 max-w-[43rem] text-[clamp(1.08rem,2vw,1.25rem)] leading-[1.55] text-muted">{site.intro}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="button" href={site.links.resume}>Resume</a>
        <a class="button button--ghost" href={site.links.github} target="_blank" rel="noopener noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <aside
      class="panel relative overflow-hidden rounded-lg border border-border shadow-soft max-[1080px]:max-w-[30rem]"
      aria-label="Professional focus"
    >
      <div
        class="relative m-5 grid aspect-square place-items-center rounded-lg border border-border-strong font-mono text-[clamp(3.5rem,10vw,5rem)] font-extrabold leading-none text-text"
        aria-hidden="true"
      >
        RW
      </div>
      <dl class="relative grid border-t border-border">
        <div class="border-b border-border px-5 py-4 last:border-b-0">
          <dt class="font-bold">10+ years</dt>
          <dd class="mt-[0.2rem] text-muted">Backend and cloud systems</dd>
        </div>
        <div class="border-b border-border px-5 py-4 last:border-b-0">
          <dt class="font-bold">AWS certified</dt>
          <dd class="mt-[0.2rem] text-muted">Developer (2023) · Solutions Architect (2020)</dd>
        </div>
        <div class="border-b border-border px-5 py-4 last:border-b-0">
          <dt class="font-bold">Vancouver, WA</dt>
          <dd class="mt-[0.2rem] text-muted">Portland, OR metro — or remote</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="pt-12" aria-labelledby="focus-title">
    <div class="mb-[1.1rem] max-w-[40rem]">
      <h2 class="text-[1.4rem]" id="focus-title">Focus</h2>
      <p class="mt-[0.35rem] text-muted">Architecture work grounded in maintainable systems and clear delivery tradeoffs.</p>
    </div>
    <div class="grid gap-4 grid-cols-[repeat(auto-fit,minmax(min(100%,16rem),1fr))]">
      {
        focusAreas.map((area) => (
          <article class="rounded-lg border border-border bg-surface p-5 shadow-soft">
            <h3 class="text-[1.1rem]">{area.title}</h3>
            <p class="mt-2 text-muted">{area.blurb}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="pt-12" aria-labelledby="elsewhere-title">
    <div class="mb-[1.1rem] max-w-[40rem]">
      <h2 class="text-[1.4rem]" id="elsewhere-title">Elsewhere</h2>
      <p class="mt-[0.35rem] text-muted">Long-form writing and working notes live outside the main site.</p>
    </div>
    <div class="grid gap-4 grid-cols-[repeat(auto-fit,minmax(min(100%,18rem),1fr))]">
      <a
        class="rounded-lg border border-border bg-surface p-5 text-inherit shadow-soft transition duration-150 hover:-translate-y-0.5 hover:border-accent hover:no-underline hover:shadow-lift"
        href={site.links.blog} target="_blank" rel="noopener noreferrer"
      >
        <h3 class="text-[1.1rem] text-accent">Blog <span aria-hidden="true">↗</span></h3>
        <p class="mt-2 text-muted">Writing on cloud architecture, engineering, and whatever I'm building.</p>
      </a>
      <a
        class="rounded-lg border border-border bg-surface p-5 text-inherit shadow-soft transition duration-150 hover:-translate-y-0.5 hover:border-accent hover:no-underline hover:shadow-lift"
        href={site.links.notes} target="_blank" rel="noopener noreferrer"
      >
        <h3 class="text-[1.1rem] text-accent">Notes <span aria-hidden="true">↗</span></h3>
        <p class="mt-2 text-muted">References, implementation notes, and technical docs.</p>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Decorative panel: a layered accent-tinted gradient over the surface, with a
     masked grid overlay. Kept as CSS — multi-layer backgrounds + mask-image do
     not translate cleanly to utility classes. */
  .panel {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 11%, transparent), transparent 42%),
      var(--color-surface);
  }

  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(160deg, black, transparent 70%);
    pointer-events: none;
  }
</style>
