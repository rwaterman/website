---
import Layout from '../layouts/Layout.astro';
import { site, socials } from '../config/site';

const sections = [
  {
    title: 'Sites',
    links: [
      { label: 'Blog', href: site.links.blog },
      { label: 'Notes', href: site.links.notes },
    ],
  },
  { title: 'Social', links: socials },
];
---

<Layout title="Links" description={`All of ${site.name}'s links in one place`}>
  <section class="mb-8">
    <h1 class="text-[clamp(1.8rem,5vw,2.4rem)]">Links</h1>
    <p class="mt-2 text-muted">Everywhere else you can find me.</p>
  </section>

  {
    sections.map((section) => (
      <section class="mb-8 max-w-[32rem]">
        <h2 class="mb-3 text-base uppercase tracking-[0.05em] text-muted">{section.title}</h2>
        <ul class="flex flex-col gap-[0.6rem]">
          {section.links.map((link) => (
            <li>
              <a
                class="flex items-center justify-between rounded-lg border border-border bg-surface px-[1.1rem] py-[0.9rem] font-[650] text-text shadow-soft transition duration-150 hover:-translate-y-0.5 hover:border-accent hover:no-underline hover:shadow-lift"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{link.label}</span>
                <span class="text-accent" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
