---
import Layout from '../layouts/Layout.astro';
import { site, socials } from '../config/site';

const sections = [
  {
    title: 'Sites',
    links: [
      { label: 'Blog', href: site.links.blog },
      { label: 'Notes', href: site.links.notes },
    ],
  },
  { title: 'Social', links: socials },
];
---

<Layout title="Links" description={`All of ${site.name}'s links in one place`}>
  <h1 class="font-display text-[clamp(2.5rem,6vw,4rem)] font-bold uppercase leading-[0.95]">Links</h1>
  <p class="mt-3 text-muted">Everywhere else you can find me.</p>

  {
    sections.map((section) => (
      <section class="mt-10 grid gap-x-12 gap-y-3 md:grid-cols-[10rem_minmax(0,1fr)]" aria-labelledby={`links-${section.title}`}>
        <h2 class="label" id={`links-${section.title}`}>{section.title}</h2>
        <ul class="max-w-[32rem] border-t border-rule-strong">
          {section.links.map((link) => (
            <li class="border-b border-rule">
              <a
                class="flex items-baseline justify-between gap-4 py-3 font-medium no-underline hover:text-accent"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{link.label}</span>
                <span class="font-mono text-[0.8rem] text-muted">{link.href.replace(/^https?:\/\//, '')} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
