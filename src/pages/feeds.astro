---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { site } from '../config/site';
import { parseOpml, type FeedGroup } from '../lib/opml';
import opml from '../../public/feeds.opml?raw';

const mine: FeedGroup = {
  title: 'Mine',
  feeds: [
    { title: 'GenAI Blog', xmlUrl: `${site.links.blog}/index.xml`, htmlUrl: site.links.blog },
    { title: 'Notes', xmlUrl: `${site.links.notes}/index.xml`, htmlUrl: site.links.notes },
  ],
};
const groups = [mine, ...parseOpml(opml)];
---

<Layout heading="Feeds" lede="What I read, by folder. The OPML export imports into any feed reader.">
  <a slot="aside" class="button" href="/feeds.opml" download="rick-waterman-feeds.opml">
    Download OPML <span aria-hidden="true">↓</span>
  </a>

  {
    groups.map((group) => (
      <Section title={group.title}>
        <ul class="columns-[16rem] gap-x-8 text-small">
          {group.feeds.map((feed) => (
            <li class="flex items-baseline justify-between gap-3 border-b border-rule py-2 break-inside-avoid">
              <a href={feed.htmlUrl ?? feed.xmlUrl} target="_blank" rel="noopener noreferrer">
                {feed.title}
              </a>
              <a class="label no-underline hover:text-text" href={feed.xmlUrl} target="_blank" rel="noopener noreferrer">
                rss
              </a>
            </li>
          ))}
        </ul>
      </Section>
    ))
  }
</Layout>
