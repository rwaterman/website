---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
import { getMemes } from '../lib/memes';

const memes = await getMemes();

const monthOf = (date: Date) => date.toLocaleString('en-US', { month: 'long', year: 'numeric' });
const dayOf = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// memes are already sorted newest-first, so insertion order keeps months in order too.
const groups: { month: string; items: typeof memes }[] = [];
for (const meme of memes) {
  const month = monthOf(meme.date);
  const group = groups.at(-1);
  if (group?.month === month) group.items.push(meme);
  else groups.push({ month, items: [meme] });
}
---

<Layout title="Memes" description={`Memes, by date — ${site.name}`}>
  <section class="page-head">
    <h1>Memes</h1>
    <p>A pile of memes, newest first.</p>
  </section>

  {
    memes.length === 0 ? (
      <p class="empty">
        No memes yet. Drop image files into <code>src/memes/</code>, commit, and they'll appear here
        sorted by date.
      </p>
    ) : (
      groups.map((group) => (
        <section class="group">
          <h2>{group.month}</h2>
          <div class="grid">
            {group.items.map((meme) => (
              <figure>
                <img
                  src={meme.src}
                  width={meme.width}
                  height={meme.height}
                  alt={meme.name}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{dayOf(meme.date)}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))
    )
  }
</Layout>

<style>
  .page-head {
    margin-bottom: 2rem;
  }

  .page-head h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
  }

  .page-head p {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }

  .empty {
    color: var(--color-muted);
  }

  .empty code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .group {
    margin-bottom: 2.5rem;
  }

  .group h2 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 1rem;
  }

  figure {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    padding: 0.5rem 0.75rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
</style>
