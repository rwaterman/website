---
// Easter egg: a faint glyph in the footer that turns the site into a dragon flight (src/lib/dragon).
// Rendered only when __DRAGON_ENABLED__ is true; see astro.config.mjs. The launcher it shares with
// the header's hover tag is src/lib/dragon/egg.ts.
---

<button type="button" class="dragon-egg" data-dragon-egg aria-label="Wake the dragon">
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path
      d="M3 20c3-1 5-3 6-6l-4-1 5-3c2-3 5-5 9-5l-2 3 5-2 1 3 4-1-1 4 3 2-3 2c0 4-3 7-7 8l1-3-4 2-1-3-4 3 0-4c-3 2-6 2-9 2z"
    ></path>
    <circle cx="20.5" cy="11.5" r="1.3" class="dragon-egg-eye"></circle>
  </svg>
</button>

<script>
  import '../lib/dragon/egg';
</script>

<style>
  .dragon-egg {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    opacity: 0.16;
    cursor: pointer;
    transition:
      opacity 0.4s ease,
      color 0.4s ease,
      filter 0.4s ease;
    /* A slow ember glow, so the glyph is findable without hovering over it. */
    animation: dragon-egg-throb 2.8s ease-in-out infinite;
  }

  @keyframes dragon-egg-throb {
    0%,
    100% {
      opacity: 0.18;
      color: var(--color-muted);
      filter: none;
    }
    50% {
      opacity: 0.9;
      color: var(--color-accent);
      filter: drop-shadow(0 0 6px var(--color-accent));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dragon-egg {
      animation: none;
      opacity: 0.5;
    }
  }

  .dragon-egg svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .dragon-egg-eye {
    fill: var(--color-bg);
  }

  .dragon-egg:hover,
  .dragon-egg:focus-visible {
    animation: none;
    opacity: 1;
    color: var(--color-accent);
    filter: drop-shadow(0 0 6px var(--color-accent));
  }
</style>
