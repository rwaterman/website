---
import { site, nav, socials } from '../config/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  !href.startsWith('http') && (href.replace(/\/$/, '') || '/') === current;
---

<aside
  class="flex-[0_0_15.5rem] border-r border-border bg-surface/88 backdrop-blur-lg max-[820px]:basis-auto max-[820px]:border-r-0 max-[820px]:border-b"
>
  <div
    class="sticky top-0 flex max-h-[100dvh] flex-col gap-[1.35rem] overflow-y-auto px-[1.2rem] py-[1.4rem] max-[820px]:static max-[820px]:max-h-none max-[820px]:gap-4"
  >
    <a class="inline-flex items-center text-[1.15rem] font-extrabold text-text hover:no-underline" href="/">
      <span
        class="mr-[0.55rem] inline-block size-[0.7rem] rounded-xs bg-accent shadow-[0_0_0_3px_color-mix(in_oklab,var(--color-accent)_14%,transparent)]"
        aria-hidden="true"
      ></span>
      {site.name}
    </a>
    <p class="-mt-[1.1rem] pl-5 text-[0.82rem] leading-[1.35] text-muted max-[820px]:hidden">{site.role}</p>

    <nav
      class="border-t border-border pt-1 max-[820px]:border-t-0 max-[820px]:pt-0"
      aria-label="Primary"
    >
      <ul class="flex flex-col gap-[0.2rem] max-[820px]:flex-row max-[820px]:flex-wrap max-[820px]:gap-1">
        {
          nav.map((link) => (
            <li>
              <a
                class="flex items-center justify-between gap-[0.25em] rounded-md px-[0.55rem] py-[0.45rem] font-[560] text-muted hover:text-text hover:no-underline aria-[current=page]:bg-accent/10 aria-[current=page]:font-semibold aria-[current=page]:text-text max-[820px]:py-[0.35rem]"
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
                {link.external && <span class="text-[0.8em] opacity-70" aria-hidden="true">↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav
      class="mt-auto flex flex-wrap gap-x-[0.85rem] gap-y-1 border-t border-border pt-1 text-[0.85rem] max-[820px]:border-t-0 max-[820px]:pt-0"
      aria-label="Social"
    >
      {
        socials.map((s) => (
          <a
            class="font-[560] text-muted hover:text-text hover:no-underline"
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</aside>
