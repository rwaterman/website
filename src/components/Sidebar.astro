---
import { site, nav, socials } from '../config/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  !href.startsWith('http') && (href.replace(/\/$/, '') || '/') === current;
---

<aside class="sidebar">
  <div class="inner">
    <a class="brand" href="/">{site.name}</a>
    <p class="role">{site.role}</p>

    <nav aria-label="Primary">
      <ul>
        {
          nav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
                {link.external && <span class="ext" aria-hidden="true">↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="socials" aria-label="Social">
      {
        socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</aside>

<style>
  .sidebar {
    flex: 0 0 15.5rem;
    border-right: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(16px);
  }

  .inner {
    position: sticky;
    top: 0;
    max-height: 100dvh;
    overflow-y: auto;
    padding: 1.4rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .brand::before {
    content: '';
    inline-size: 0.7rem;
    block-size: 0.7rem;
    margin-right: 0.55rem;
    border-radius: 2px;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 14%, transparent);
  }

  .role {
    margin-top: -1.1rem;
    padding-left: 1.25rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .brand:hover {
    text-decoration: none;
  }

  nav {
    padding-top: 0.25rem;
    border-top: 1px solid var(--color-border);
  }

  nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25em;
    color: var(--color-muted);
    padding: 0.45rem 0.55rem;
    border-radius: 6px;
    font-weight: 560;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    font-weight: 600;
  }

  .ext {
    font-size: 0.8em;
    opacity: 0.7;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.85rem;
    font-size: 0.85rem;
    margin-top: auto;
  }

  .socials a {
    color: var(--color-muted);
    padding: 0;
  }

  .socials a:hover {
    color: var(--color-text);
  }

  /* Collapse to a top bar on narrow screens. */
  @media (max-width: 820px) {
    .sidebar {
      flex-basis: auto;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .inner {
      position: static;
      max-height: none;
      gap: 1rem;
    }

    .role {
      display: none;
    }

    nav {
      border-top: 0;
      padding-top: 0;
    }

    nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem;
    }

    nav a {
      padding: 0.35rem 0.55rem;
    }
  }
</style>
