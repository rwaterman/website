---
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border text-[0.9rem] text-muted">
  <div class="mx-auto flex w-full max-w-[68rem] flex-wrap items-center justify-between gap-3 px-5 py-6">
    <p>© {year} {site.name}</p>
    <nav class="flex flex-wrap gap-4" aria-label="Footer">
      <a class="text-muted hover:text-text" href={site.links.blog} target="_blank" rel="noopener noreferrer">Blog</a>
      <a class="text-muted hover:text-text" href={site.links.notes} target="_blank" rel="noopener noreferrer">Notes</a>
      <a class="text-muted hover:text-text" href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
  </div>
</footer>
