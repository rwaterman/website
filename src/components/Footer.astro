---
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p>© {year} {site.name}</p>
    <nav aria-label="Footer">
      <a href={site.links.blog} target="_blank" rel="noopener noreferrer">Blog</a>
      <a href={site.links.notes} target="_blank" rel="noopener noreferrer">Notes</a>
      <a href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .inner {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  nav a {
    color: var(--color-muted);
  }

  nav a:hover {
    color: var(--color-text);
  }
</style>
