---
/**
 * The Tracker Museum section of /fun: a module player with a live pattern display, and the
 * exhibit list it plays from. Exhibits come from src/config/tracker-museum.ts; the placard is
 * rendered here for the first one and src/lib/tracker-museum.ts rewrites it as pieces change.
 */
import Section from './Section.astro';
import { credit, eras, exhibits, pageUrl, yearLabel } from '../config/tracker-museum';

const first = exhibits[0];
const last = exhibits.at(-1);
if (!first || !last) throw new Error('The Tracker Museum needs at least one exhibit');

const wings = eras.map((era) => ({ era, pieces: exhibits.filter((exhibit) => exhibit.era === era.id) }));
const firstEra = eras.find((era) => era.id === first.era);
if (!firstEra) throw new Error(`Exhibit "${first.title}" names an era that is not in eras`);

/** Pattern rows on screen. Odd, so the row being played sits in the middle. */
const PATTERN_ROWS = 13;
---

<Section title="Tracker Museum">
  <p class="max-w-[38rem] text-muted">
    A tracker module is the score, not the recording: a handful of short samples and a grid of notes, small enough
    for a floppy disk, performed live by the machine. The Amiga and PC demoscenes shipped music this way for a
    decade before MP3. These {exhibits.length} pieces run from {first.year} to {last.year} and play here the same
    way: libopenmpt, compiled to WebAssembly, performs every row in your browser while the pattern scrolls past.
  </p>
  <p class="mt-3 max-w-[38rem] text-small text-muted">
    Each piece is the work of its composer. The files stream from{' '}
    <a href="https://modarchive.org/" target="_blank" rel="noopener noreferrer">The Mod Archive</a> when you press
    play; none are hosted here.
  </p>

  <div class="mt-6 grid grid-cols-1 gap-px lg:grid-cols-[minmax(0,1fr)_21rem]" data-tracker>
    <div class="min-w-0 bg-surface ring-1 ring-rule">
      <div class="flex flex-col gap-2 p-5">
        <p class="label" data-tracker-field="era">{yearLabel(first)} · {firstEra.title}</p>
        <h3 class="font-display text-h2 font-bold uppercase tracking-[0.01em]" data-tracker-field="title">
          {first.title}
        </h3>
        <p class="font-semibold" data-tracker-field="credit">{credit(first)}</p>
        <p class="label" data-tracker-field="origin">{first.origin}</p>
        <p class="max-w-[36rem] text-small text-muted" data-tracker-field="blurb">{first.blurb}</p>
        <p class="mt-1 flex flex-wrap gap-2" data-tracker-field="file"><span class="chip">{first.format}</span></p>
        <p class="label mt-1">
          <a class="hover:text-text" href={pageUrl(first)} target="_blank" rel="noopener noreferrer" data-tracker-source>
            This module on The Mod Archive <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 border-t border-rule p-5">
        <button type="button" class="button min-w-[6.5rem] justify-center" data-tracker-toggle>Play</button>
        <button type="button" class="button button--ghost" data-tracker-step="-1" aria-label="Previous exhibit">
          Prev
        </button>
        <button type="button" class="button button--ghost" data-tracker-step="1" aria-label="Next exhibit">Next</button>
        <input
          type="range"
          class="tracker-seek"
          min="0"
          max="1"
          step="any"
          value="0"
          disabled
          aria-label="Position in the piece"
          data-tracker-seek
        />
        <span class="label" data-tracker-time>0:00 / 0:00</span>
        <p class="basis-full text-small text-muted" role="status" data-tracker-status>
          Nothing downloads until you press play.
        </p>
      </div>

      <div class="border-t border-rule bg-surface-2 p-5">
        <dl class="tracker-readout">
          <div><dt>Order</dt><dd data-tracker-live="order">--</dd></div>
          <div><dt>Pattern</dt><dd data-tracker-live="pattern">--</dd></div>
          <div><dt>Row</dt><dd data-tracker-live="row">--</dd></div>
          <div><dt>Speed</dt><dd data-tracker-live="speed">--</dd></div>
          <div><dt>BPM</dt><dd data-tracker-live="tempo">--</dd></div>
        </dl>
        <div
          class="tracker-pattern mt-4"
          role="img"
          tabindex="0"
          aria-label="The pattern being played: one column of notes per channel, scrolling with the music"
          data-tracker-pattern
        >
          <pre data-tracker-head> </pre>
          <div class="tracker-meters" data-tracker-meters></div>
          <pre class="tracker-rows" data-tracker-rows>{Array.from({ length: PATTERN_ROWS }, (_, index) => <span data-current={index === (PATTERN_ROWS - 1) / 2 || undefined} />)}</pre>
        </div>
        <p class="text-small text-muted" hidden data-tracker-still>
          The scrolling pattern and level meters are off because your system asks for reduced motion.
        </p>
      </div>

      <details class="border-t border-rule p-5" hidden data-tracker-notes>
        <summary class="label cursor-pointer hover:text-text">Sample names, where composers signed their work</summary>
        <pre class="mt-3 overflow-x-auto font-mono text-[0.78rem] leading-[1.5] text-muted" data-tracker-samples></pre>
      </details>
    </div>

    <div class="relative min-w-0 bg-surface ring-1 ring-rule">
      <ol class="max-h-[30rem] overflow-y-auto lg:absolute lg:inset-0 lg:max-h-none" aria-label="Exhibits, oldest first" data-tracker-list>
        {
          wings.map(({ era, pieces }) => (
            <li>
              <h3 class="label sticky top-0 z-10 border-b border-rule-strong bg-surface-2 px-4 py-3 text-text">
                {era.title} · {era.from}–{era.to ?? 'today'}
              </h3>
              <p class="border-b border-rule px-4 py-3 text-small text-muted">{era.blurb}</p>
              <ol>
                {pieces.map((exhibit) => (
                  <li>
                    <button
                      type="button"
                      class="tracker-exhibit"
                      data-tracker-exhibit={exhibit.modarchiveId}
                      aria-current={exhibit === first ? 'true' : undefined}
                    >
                      <span class="label whitespace-nowrap">{yearLabel(exhibit)}</span>
                      <span class="min-w-0">
                        <span class="block font-semibold">{exhibit.title}</span>
                        <span class="block text-small text-muted">{credit(exhibit)}</span>
                      </span>
                      <span class="chip">{exhibit.format}</span>
                    </button>
                  </li>
                ))}
              </ol>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Section>

<script>
  import '../lib/tracker-museum';
</script>
