---
import { site, nav } from '../config/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  !href.startsWith('http') && (href.replace(/\/$/, '') || '/') === current;
---

<header class="border-b border-rule">
  <div
    class="mx-auto flex w-full max-w-[64rem] flex-wrap items-baseline justify-between gap-x-8 gap-y-3 px-6 py-5"
  >
    <a class="font-display text-[1.35rem] font-bold uppercase leading-none tracking-[0.02em] no-underline" href="/">
      {site.name}
    </a>

    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.8rem] uppercase tracking-[0.1em]">
        {
          nav.map((link) => (
            <li>
              <a
                class="inline-block border-b-2 border-transparent py-1 text-muted no-underline hover:text-text aria-[current=page]:border-accent aria-[current=page]:text-text"
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
                {link.external && <span aria-hidden="true">&nbsp;↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
