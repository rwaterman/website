---
import { site, nav } from '../config/site';
import { shaders } from '../config/shaders';

interface Props {
  /** Id of the shader (src/config/shaders.ts) drawn behind the page; omit for none. */
  background?: string;
}

const { background } = Astro.props;
const backgroundShader = background ? shaders.find((shader) => shader.id === background) : undefined;
if (background && !backgroundShader) throw new Error(`Unknown background shader "${background}"`);

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  !href.startsWith('http') && (href.replace(/\/$/, '') || '/') === current;
---

<header class="border-b border-rule bg-bg/85">
  {
    backgroundShader && (
      <div data-shader={backgroundShader.id} data-background>
        <canvas aria-hidden="true" />
        <p
          data-error
          hidden
          class="fixed inset-x-0 top-0 z-40 m-4 bg-bg/90 p-4 font-mono text-[0.8rem] whitespace-pre-wrap text-accent"
        />
        <div hidden>
          <code data-shader-source={backgroundShader.id}>{backgroundShader.source}</code>
        </div>
      </div>
    )
  }
  <div class="container-site grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-3 py-4 lg:flex lg:gap-x-8 lg:py-5">
    <a class="flex items-center gap-3 no-underline" href="/">
      <!-- RW mark: IBM Plex Sans Condensed Bold outlined to paths (same generator as public/favicon.svg,
           which uses a taller cap height for legibility at 16px), so it renders identically everywhere
           with no dependency on the web font. -->
      <svg class="h-7 w-7 shrink-0" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="6" class="fill-text" />
        <path class="fill-bg" d="M11.537249283667618 40.0H6.2106017191977045V14.0H17.459885386819483Q20.96131805157593 14.0 22.786532951289395 16.197707736389685Q24.611747851002864 18.39541547277937 24.611747851002864 22.083094555873924Q24.611747851002864 24.9512893982808 23.531518624641834 26.925501432664753Q22.4512893982808 28.89971346704871 20.32808022922636 29.681948424068768L24.872492836676216 40.0H19.09885386819484L15.075931232091687 30.16618911174785H11.537249283667618ZM16.78939828080229 25.733524355300858Q17.869627507163322 25.733524355300858 18.484240687679083 25.193409742120345Q19.09885386819484 24.653295128939828 19.09885386819484 23.312320916905442V21.077363896848137Q19.09885386819484 19.73638968481375 18.484240687679083 19.196275071633238Q17.869627507163322 18.65616045845272 16.78939828080229 18.65616045845272H11.537249283667618V25.733524355300858Z M32.087392550143264 40.0 26.872492836676216 14.0H32.124641833810884L34.58309455587393 28.378223495702006L35.25358166189112 34.15186246418338H35.84957020057307L36.52005730659026 28.52722063037249L39.5 14.0H45.34813753581662L48.36532951289398 28.52722063037249L49.03581661891117 34.15186246418338H49.63180515759312L50.30229226361031 28.378223495702006L52.723495702005735 14.0H57.78939828080229L52.35100286532951 40.0H46.316618911174785L43.2621776504298 25.025787965616047L42.59169054441261 19.84813753581662H41.995702005730664L41.325214899713465 25.025787965616047L38.27077363896848 40.0Z" />
        <rect x="6.21" y="45.00" width="51.58" height="5" class="fill-accent" />
      </svg>
      <span class="font-display text-[1.35rem] font-bold uppercase leading-none tracking-[0.02em]">{site.name}</span>
    </a>

    <nav class="col-span-2 min-w-0 lg:col-auto lg:ml-auto" aria-label="Primary">
      <ul
        class="strip max-w-full font-mono text-[0.8rem] uppercase tracking-[0.1em] lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0 lg:[mask-image:none]"
      >
        {
          nav.map((link) => (
            <li>
              <a
                class="inline-block border-b-2 border-transparent py-1 whitespace-nowrap text-muted no-underline hover:text-text aria-[current=page]:border-accent aria-[current=page]:text-text"
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
                {link.external && <span aria-hidden="true">&nbsp;↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
