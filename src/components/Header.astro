---
import { site, nav } from '../config/site';
import { shaders } from '../config/shaders';

interface Props {
  /** Id of the shader (src/config/shaders.ts) drawn behind the page; omit for none. */
  background?: string;
}

const { background } = Astro.props;
const backgroundShader = background ? shaders.find((shader) => shader.id === background) : undefined;
if (background && !backgroundShader) throw new Error(`Unknown background shader "${background}"`);

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  !href.startsWith('http') && (href.replace(/\/$/, '') || '/') === current;
---

<header class="border-b border-rule bg-bg/85">
  {
    backgroundShader && (
      <div data-shader={backgroundShader.id} data-background>
        <canvas aria-hidden="true" />
        <p
          data-error
          hidden
          class="fixed inset-x-0 top-0 z-40 m-4 bg-bg/90 p-4 font-mono text-[0.8rem] whitespace-pre-wrap text-accent"
        />
        <div hidden>
          <code data-shader-source={backgroundShader.id}>{backgroundShader.source}</code>
        </div>
      </div>
    )
  }
  <div class="container-site grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-3 py-4 lg:flex lg:gap-x-8 lg:py-5">
    <a class="flex items-center gap-3 no-underline" href="/">
      <!-- RW mark: IBM Plex Sans Condensed Bold outlined to paths, so it renders identically to
           public/favicon.svg with no dependency on the web font. Regenerate both together. -->
      <svg class="h-8 w-8 shrink-0" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="6" class="fill-text" />
        <path class="fill-bg" d="M8.542979942693412 42.0H2.3968481375358195V12.000000000000004H15.376790830945561Q19.416905444126076 12.000000000000004 21.522922636103154 14.535816618911177Q23.62893982808023 17.07163323782235 23.62893982808023 21.326647564469916Q23.62893982808023 24.636103151862464 22.382521489971346 26.91404011461318Q21.136103151862464 29.191977077363898 18.68624641833811 30.0945558739255L23.9297994269341 42.0H17.26790830945559L12.626074498567338 30.65329512893983H8.542979942693412ZM14.603151862464184 25.53868194842407Q15.849570200573066 25.53868194842407 16.558739255014327 24.91547277936963Q17.26790830945559 24.29226361031519 17.26790830945559 22.74498567335244V20.16618911174785Q17.26790830945559 18.6189111747851 16.558739255014327 17.99570200573066Q15.849570200573066 17.37249283667622 14.603151862464184 17.37249283667622H8.542979942693412V25.53868194842407Z M31.946991404011463 42.0 25.9297994269341 12.000000000000004H31.98997134670487L34.826647564469916 28.59025787965616L35.60028653295129 35.25214899713467H36.287965616045845L37.06160458452722 28.7621776504298L40.5 12.000000000000004H47.24785100286533L50.72922636103152 28.7621776504298L51.50286532951289 35.25214899713467H52.19054441260745L52.96418338108882 28.59025787965616L55.757879656160455 12.000000000000004H61.60315186246418L55.32808022922636 42.0H48.36532951289398L44.84097421203438 24.722063037249285L44.067335243553 18.747851002865332H43.37965616045845L42.606017191977074 24.722063037249285L39.08166189111748 42.0Z" />
        <rect x="2.40" y="47.00" width="59.21" height="5" class="fill-accent" />
      </svg>
      <span class="font-display text-[1.35rem] font-bold uppercase leading-none tracking-[0.02em]">{site.name}</span>
    </a>

    <nav class="col-span-2 min-w-0 lg:col-auto lg:ml-auto" aria-label="Primary">
      <ul
        class="strip max-w-full font-mono text-[0.8rem] uppercase tracking-[0.1em] lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0 lg:[mask-image:none]"
      >
        {
          nav.map((link) => (
            <li>
              <a
                class="inline-block border-b-2 border-transparent py-1 whitespace-nowrap text-muted no-underline hover:text-text aria-[current=page]:border-accent aria-[current=page]:text-text"
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
                {link.external && <span aria-hidden="true">&nbsp;↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
