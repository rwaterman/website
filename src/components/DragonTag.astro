---
// Easter egg: a tag in the header that stays invisible until the pointer finds it (or keyboard
// focus lands on it), then wakes the dragon exactly as the footer glyph does (src/lib/dragon/egg.ts).
// Rendered only when __DRAGON_ENABLED__ is true; see astro.config.mjs. Devices without hover never
// get it, so an invisible tap target cannot start the game by accident.
---

<button type="button" class="dragon-tag" data-dragon-tag>Here be dragons</button>

<script>
  import '../lib/dragon/egg';
</script>

<style>
  .dragon-tag {
    border: 1px solid var(--color-accent);
    border-radius: 2px;
    padding: 0.2em 0.55em;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.35s ease,
      box-shadow 0.35s ease;
  }

  .dragon-tag:hover,
  .dragon-tag:focus-visible {
    opacity: 1;
    box-shadow: 0 0 12px -2px var(--color-accent);
  }

  @media (hover: none) {
    .dragon-tag {
      display: none;
    }
  }
</style>
